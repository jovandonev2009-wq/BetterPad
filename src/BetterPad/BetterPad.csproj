<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>BetterPad</AssemblyName>
    <RootNamespace>BetterPad</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>BetterPad</Product>
    <Description>A local, offline text and code editor.</Description>
    <Copyright>Built with WPF on .NET.</Copyright>
    <ApplicationIcon>Assets\BetterPad.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BetterPad.Language\BetterPad.Language.csproj" />
    <ProjectReference Include="..\BetterPad.PluginSdk\BetterPad.PluginSdk.csproj" />
    <ProjectReference Include="..\..\samples\WordCountPlugin\WordCountPlugin.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\BetterPad.ico" />
    <Content Include="resources\syntax\*.json"
             Link="syntax\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopySamplePlugins" AfterTargets="Build">
    <ItemGroup>
      <SamplePluginFiles Include="..\..\samples\WordCountPlugin\bin\$(Configuration)\net10.0\WordCountPlugin.dll"
                         Condition="Exists('..\..\samples\WordCountPlugin\bin\$(Configuration)\net10.0\WordCountPlugin.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(SamplePluginFiles)"
          DestinationFolder="$(OutDir)sample-plugins"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
